# ==============================================================================
# .gitignore για το έργο "Γυμνάσιο Νέας Ερυθραίας - Φυσικές Επιστήμες"
# ==============================================================================

# 1. Προσωρινά αρχεία κλειδώματος του Microsoft Office (Word, Excel)
~$*
*.~*
*.tmp
*.bak

# 2. Αρχεία πηγαίου υλικού, θεμάτων εξετάσεων, λύσεων και εγγράφων
# Αποτρέπει τη δημόσια έκθεση διαγωνισμάτων, επίσημων λύσεων και φυλλαδίων PDF
*.docx
*.doc
*.pdf

# 3. Αρχεία συστήματος Windows & macOS
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.lnk

# 4. Αρχεία καταγραφής & προσωρινά scripts
*.log
scratch/
temp/

# 5. Python caches (αν εκτελεστούν βοηθητικά scripts)
__pycache__/
*.py[cod]
*$py.class

# 6. Ρυθμίσεις περιβάλλοντος ανάπτυξης / IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ==============================================================================
# ΣΗΜΕΙΩΣΗ: Τα παρακάτω αρχεία ΕΙΝΑΙ ΑΠΑΡΑΙΤΗΤΑ για τη λειτουργία του GitHub Pages:
# - index.html
# - css/
# - js/
# - assets/
# - .nojekyll
# - README.md
# ==============================================================================
Χημεία Γ 2026 - 2027/
"Χημεία Γ 2026 - 2027/"
